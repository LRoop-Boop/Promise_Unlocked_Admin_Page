{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://api-xbdqcem4zq-uc.a.run.app/auth/:path*"
    },
    {
      "source": "/participants/:path*",
      "destination": "https://api-xbdqcem4zq-uc.a.run.app/participants/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://api-xbdqcem4zq-uc.a.run.app/admin/:path*"
    },
    {
      "source": "/sessions/:path*",
      "destination": "https://api-xbdqcem4zq-uc.a.run.app/sessions/:path*"
    },
    {
      "source": "/pva-catalog",
      "destination": "https://api-xbdqcem4zq-uc.a.run.app/pva-catalog"
    },
    {
      "source": "/((?!auth|participants|admin|sessions|pva-catalog|assets|.*\\..*).*)",
